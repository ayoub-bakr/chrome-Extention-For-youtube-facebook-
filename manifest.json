{
  "manifest_version": 3,
  "name": "Focus Mode - Intentional Browsing",
  "version": "1.0.0",
  "description": "Reduces addictive feeds and Shorts/Reels while prioritizing intentional search on YouTube and Facebook.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Focus Mode Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/shared.js",
        "content/youtube.js"
      ],
      "css": [
        "content/youtube.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "content/shared.js",
        "content/facebook.js"
      ],
      "css": [
        "content/facebook.css"
      ],
      "run_at": "document_start"
    }
  ]
}
